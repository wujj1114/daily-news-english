      "story_index": 2
    },
    {
      "type": "en",
      "lang": "en",
      "text": "Apple has started a new research program for AI health tools.",
      "start_sec": 129.144,
      "end_sec": 134.596,
      "audio_file": "/home/runner/work/daily-news-english/daily-news-english/.tts_cache/4ef48bb6662a8a3ef97b7506eac0981dc782ec0700f6bb9b5f1ad49bd40ab566.wav",
      "story_index": 2,
      "sentence_id": "s01"
    },
    {
      "type": "zh",
      "lang": "zh",
      "text": "蘋果公司已啟動一項新的人工智慧健康工具研究計畫。",
      "start_sec": 135.396,
      "end_sec": 140.527,
      "audio_file": "/home/runner/work/daily-news-english/daily-news-english/.tts_cache/74fc9d9ade99a829eb8e07443955648353c1122be15272676f40b187c3e1ade4.wav",
      "story_index": 2,
      "sentence_id": "s01"
    },
    {
      "type": "en",
      "lang": "en",
      "text": "It aims to improve the accuracy of medical information for users.",
      "start_sec": 141.127,
      "end_sec": 146.491,
