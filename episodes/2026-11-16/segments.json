      "story_index": 1,
      "sentence_id": "s04"
    },
    {
      "type": "zh",
      "lang": "zh",
      "text": "全球對人工智慧的強勁需求推動了這項擴張。",
      "start_sec": 77.248,
      "end_sec": 81.419,
