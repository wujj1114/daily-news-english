    {
      "type": "zh",
      "lang": "zh",
      "text": "第 1 則新聞：臺灣經濟前景看好，成長預測強勁",
      "start_sec": 10.061,
      "end_sec": 14.232,
      "audio_file": "/home/runner/work/daily-news-english/daily-news-english/.tts_cache/c7f838600e785183b0b3a5ab4fd64d6b3a17b766560f9f434972d9c8c9ad642c.wav",
      "story_index": 1
    },
    {
      "type": "en",
      "lang": "en",
      "text": "Taiwan's economic forecast for 2026 has been raised to 12.16%.",
